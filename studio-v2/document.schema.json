{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docsctl Studio v2 authoring document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "subtitle",
    "author",
    "date",
    "format",
    "theme",
    "pages"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "subtitle": {
      "type": "string",
      "maxLength": 240
    },
    "author": {
      "type": "string",
      "maxLength": 120
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "format": {
      "enum": [
        "portrait",
        "landscape"
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accent",
        "ink",
        "paper",
        "font"
      ],
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "ink": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "paper": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "font": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_ -]{1,64}$"
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "body",
          "art",
          "blur",
          "mermaid"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "kind": {
            "enum": [
              "cover",
              "abstract",
              "contents",
              "chapter",
              "method",
              "architecture",
              "results",
              "matrix",
              "timeline",
              "equations",
              "references",
              "figure",
              "table",
              "glossary",
              "appendix",
              "limitations",
              "reproducibility",
              "conclusion"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 140
          },
          "body": {
            "type": "string",
            "maxLength": 12000
          },
          "art": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "blur": {
            "type": "number",
            "minimum": 0,
            "maximum": 12
          },
          "mermaid": {
            "type": "string",
            "maxLength": 12000
          }
        }
      }
    }
  }
}
